{
  "name": "klipanalista",
  "version": "0.2.0",
  "private": true,
  "description": "Klip Analista - atendimentos da KlipFlowi sincronizados no Supabase",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
