{
  "name": "flowi-copilot-comercial",
  "version": "0.1.0",
  "private": true,
  "description": "Flowi Copilot Comercial - consultor de CRM e inteligencia comercial para a KlipFlowi",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:scoring": "tsx --tsconfig scripts/tsconfig.json scripts/verify-scoring.ts",
    "test": "tsx --tsconfig tests/tsconfig.json --test tests/*.test.ts",
    "test:watch": "tsx --tsconfig tests/tsconfig.json --test --watch tests/*.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "exceljs": "^4.4.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.35.0",
    "eslint-config-next": "^16.3.5",
    "playwright": "^1.63.0",
    "tailwindcss": "4.1.13",
    "tsx": "^4.23.13",
    "typescript": "5.9.2"
  },
  "overrides": {
    "uuid": "^11.1.0"
  }
}
