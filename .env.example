# =============================================================================
# Flowi Copilot Comercial - variaveis de ambiente
# -----------------------------------------------------------------------------
# Copie este arquivo para `.env.local` e preencha os valores.
# NENHUMA destas variaveis pode receber o prefixo NEXT_PUBLIC_.
# O token permanente e lido apenas no servidor (route handlers).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Credencial da API KlipFlowi (SOMENTE SERVIDOR)
# -----------------------------------------------------------------------------
# Token permanente emitido pela KlipFlowi. Nunca exponha no frontend.
FLW_API_TOKEN=

# -----------------------------------------------------------------------------
# 2. URLs base por grupo de endpoints
# -----------------------------------------------------------------------------
# CONFIRMADO na documentacao oficial: o host e `api.wts.chat` e o caminho segue
# o formato /{grupo}/{versao}/{recurso}. A pagina "Atualizar etiquetas" mostra
# a URL completa: https://api.wts.chat/core/v1/contact/{id}/tags
#
# Os grupos correspondem as secoes do menu da documentacao:
#   core -> contatos, etiquetas, equipes, usuarios, webhooks, arquivos, campos
#   chat -> conversas, mensagens, notas internas, canais, chatbots, envios
#   crm  -> paineis e cards
#
# ESTAS TRES JA TEM PADRAO NO CODIGO — so preencha para instancia dedicada.
# FLW_CORE_API_URL=https://api.wts.chat/core
# FLW_CHAT_API_URL=https://api.wts.chat/chat
# FLW_CRM_API_URL=https://api.wts.chat/crm

# Login integrado. Sem valor, recai sobre o core.
# PENDENTE: o caminho do endpoint ainda nao foi confirmado.
FLW_AUTH_API_URL=

# -----------------------------------------------------------------------------
# 3. Provedor de IA (SOMENTE SERVIDOR)
# -----------------------------------------------------------------------------
# Chave da API Anthropic (sk-ant-...), obtida em console.anthropic.com.
#
# OPCIONAL. Sem ela o modulo funciona: a deteccao deterministica continua
# sendo o piso. Com ela, um analista le cada conversa e encontra o que
# expressao regular nao alcanca — ironia, contexto longo, pedido implicito.
#
# O QUE E ENVIADO: o texto das conversas analisadas, com telefone, e-mail,
# CPF e CNPJ mascarados antes de sair do servidor. Nome do contato vai junto,
# porque a analise precisa saber com quem se fala. Decida isso conscientemente
# — e um provedor externo lendo conversa de cliente.
#
# A IA nunca define a pontuacao: ela devolve sinais com o trecho literal que
# os sustenta, o trecho e conferido contra a conversa real, e o motor de score
# deterministico continua decidindo. Sinal com trecho inexistente e descartado.
AI_PROVIDER_API_KEY=

# Credencial da OpenAI. Opcional.
#
# Configurar as duas nao e redundancia: quem nao atender vira RESERVA
# automatica. Quando o credito da Anthropic acabou, a leitura por IA parou
# inteira e o painel passou dias so com a deteccao deterministica — com as
# duas chaves isso teria sido um contratempo, nao uma parada.
# OPENAI_API_KEY=

# Qual provedor atende primeiro: anthropic (padrao) ou openai.
# O outro, quando tem credencial, atende quando o primeiro recusa.
# AI_PROVIDER=anthropic

# Modelo do provedor principal. Padrao: claude-opus-5 / gpt-5.1.
#
# E a alavanca de custo mais direta. Mas compare pelo preco por analise
# APROVEITADA, nao por chamada: a resposta passa por uma verificacao que
# descarta afirmacao sem trecho real, e um modelo mais barato que tem metade
# dos sinais descartados sai mais caro. A contagem aparece em `aiStats`.
# AI_MODEL=claude-opus-5

# Modelo do provedor reserva. Sem isso, o padrao dele.
# Nome de modelo nao atravessa fronteira: mandar claude-opus-5 para a OpenAI
# so produziria um erro por conversa.
# AI_MODEL_RESERVA=

# Esforco de raciocinio por conversa: low | medium | high | xhigh | max.
# Padrao: low.
#
# Medido contra conta real: com esforco alto, UMA leva de 4 conversas gastou
# os 22s de orcamento inteiros — 4 conversas lidas de 57. Ler uma conversa e
# apontar qual frase sustenta cada sinal e leitura, nao raciocinio profundo.
# A troca nao era "57 bem lidas contra 57 por cima": era 57 contra 4.
# AI_EFFORT=low

# Conversas analisadas em paralelo. Padrao: 20, teto 40.
# E o que converte o orcamento de tempo em cobertura.
# AI_CONCORRENCIA=20

# -----------------------------------------------------------------------------
# 4. Aplicacao
# -----------------------------------------------------------------------------
# URL publica onde este modulo esta hospedado. Usada para montar deep links.
APP_BASE_URL=http://localhost:3000

# Origens da KlipFlowi autorizadas a incorporar este modulo em iframe/popup.
# Separadas por virgula. Sem isso, apenas 'self' pode enquadrar a pagina.
FLW_EMBED_ORIGINS=

# -----------------------------------------------------------------------------
# 5. Webhooks
# -----------------------------------------------------------------------------
# Segredo compartilhado para validar a assinatura HMAC dos webhooks recebidos.
# Gere com: openssl rand -hex 32
FLW_WEBHOOK_SECRET=

# Nome do header que transporta a assinatura do webhook.
# PENDENTE DE VALIDACAO: confirmar na documentacao oficial da KlipFlowi qual
# header e qual algoritmo sao usados antes de habilitar em producao.
FLW_WEBHOOK_SIGNATURE_HEADER=x-klipflowi-signature

# -----------------------------------------------------------------------------
# 6. Modo de operacao dos dados
# -----------------------------------------------------------------------------
# Deriva sozinho da presenca de FLW_API_TOKEN: com token, usa a API real; sem
# token, usa o dataset simulado. So preencha para forcar um dos dois.
#   mock -> ignora a credencial e usa o dataset simulado
#   live -> forca o uso da API real
# FLW_DATA_MODE=

# -----------------------------------------------------------------------------
# 7. Overrides de caminho de endpoint (opcional)
# -----------------------------------------------------------------------------
# Cada caminho declarado em src/server/integration/endpoints.ts esta marcado
# como PENDING_VALIDATION. Ao confirmar um caminho na documentacao oficial,
# informe-o aqui (ou edite o registry) para liberar a chamada real.
# Exemplo:
# FLW_EP_CARDS_LIST=/v2/panel/card

# -----------------------------------------------------------------------------
# 8. Campo personalizado de empresa (opcional)
# -----------------------------------------------------------------------------
# O contrato de contato da KlipFlowi NAO tem campo de empresa — `companyId` na
# resposta e o id da CONTA, nao o empregador do contato. Se a sua conta guarda a
# empresa em um campo personalizado, informe o nome dele aqui. Sem isso, o
# modulo simplesmente nao exibe empresa.
FLW_CONTACT_COMPANY_FIELD=

# -----------------------------------------------------------------------------
# 9. Escrita de cards no CRM
# -----------------------------------------------------------------------------
# O contrato de PUT /crm/v3/panel/card/{id} esta confirmado, mas os 14 valores
# do enum `fields` nao aparecem na documentacao publica. A grafia usada e
# PascalCase (StepId, MonetaryAmount...), inferida do texto da propria pagina.
# Se a API recusar os nomes, troque para camelCase:
# FLW_CARD_FIELDS_CASE=camel

# Libera a escrita real de cards. Mantenha vazio ate confirmar o enum acima.
FLW_CARD_WRITE_CONFIRMED=
