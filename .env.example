# Klip Analista — copie para .env.local. Nada aqui pode ter prefixo NEXT_PUBLIC_.

# KlipFlowi ---------------------------------------------------------------------
# Token permanente (Configurações > Integrações > Integração API). Só no servidor.
FLW_API_TOKEN=
# Id da conta. O app só abre com ?accountId=<este valor> (menu personalizado da KlipFlowi).
FLW_ACCOUNT_ID=
# Recomendado: chave extra exigida na URL (?chave=...), já que o accountId não é segredo.
APP_CHAVE_ACESSO=
# Origens que podem abrir o app em iframe (separadas por vírgula), ex.: https://app.klipflowi.com.br
FLW_EMBED_ORIGINS=
# FLW_API_URL=https://api.wts.chat

# Supabase ----------------------------------------------------------------------
SUPABASE_URL=
# Settings > API Keys > service_role (secreta; só no servidor).
SUPABASE_SERVICE_ROLE_KEY=

# Sincronização -----------------------------------------------------------------
# Quantos dias de conversas puxar (por interação recente).
SYNC_JANELA_DIAS=7
# Apagar automaticamente conversas sem interação há mais de N dias (vazio = desligado).
RETENCAO_DIAS=
# Segredo do cron diário da Vercel (a Vercel envia como Authorization: Bearer <valor>).
CRON_SECRET=
